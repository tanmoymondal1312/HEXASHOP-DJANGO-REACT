# ─── Django ───────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-very-secret-key-change-in-production
DJANGO_SETTINGS_MODULE=hexashop.settings.development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
POSTGRES_DB=hexashop_db
POSTGRES_USER=hexashop_user
POSTGRES_PASSWORD=hexashop_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hexashop_user:hexashop_password@db:5432/hexashop_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@hexashop.com

# ─── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN_BACKEND=
SENTRY_DSN_FRONTEND=

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000

# ─── Next.js ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_SENTRY_DSN=
