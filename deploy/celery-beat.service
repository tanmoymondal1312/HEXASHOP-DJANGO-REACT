[Unit]
Description=HEXASHOP Celery Beat Scheduler
After=network.target redis.service

[Service]
User=hexashop
Group=www-data
WorkingDirectory=/var/www/hexashop/backend
EnvironmentFile=/var/www/hexashop/.env
ExecStart=/var/www/hexashop/venv/bin/celery \
    -A celery_app beat \
    -l info \
    --scheduler django_celery_beat.schedulers:DatabaseScheduler \
    --logfile=/var/log/hexashop/celery-beat.log
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
